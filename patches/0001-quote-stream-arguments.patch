diff --git a/lib/source-platform.ts b/lib/source-platform.ts
new file mode 100644
index 0000000..b7c2191
--- /dev/null
+++ b/lib/source-platform.ts
@@ -0,0 +1,7 @@
+export function sourcePlatform(url: URL): 'youtube' | 'twitch' | undefined {
+  if (!['https:', 'http:'].includes(url.protocol) || url.username || url.password) return;
+  const host = url.hostname.toLowerCase();
+  const matches = (domain: string) => host === domain || host.endsWith('.' + domain);
+  if (matches('youtube.com') || matches('youtu.be')) return 'youtube';
+  if (matches('twitch.tv')) return 'twitch';
+}
